SAAS_PORT=8084
PHPMYADMIN_PORT=8083
MYSQL_PORT=3307

SAAS_DATABASE=invoicehost
MYSQL_USER=invoicing
MYSQL_PASSWORD=invoicing
MYSQL_ROOT_PASSWORD=rootsecret

SAAS_URL=http://localhost:8084
APP_SECRET=local-dev-change-this-secret
SI_DEBUG=1

# Hosting: set SAAS_URL to https://yourdomain.com (no trailing slash),
# keep APP_SECRET the same as this machine so public invoice links still work,
# and set SI_DEBUG=0. Do not publish MySQL or phpMyAdmin on the public internet.
