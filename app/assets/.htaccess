<IfModule mod_rewrite.c>
  RewriteEngine Off
</IfModule>

<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js
  AddType image/svg+xml .svg
</IfModule>

<FilesMatch "\.css$">
  ForceType text/css
</FilesMatch>
<FilesMatch "\.js$">
  ForceType application/javascript
</FilesMatch>
